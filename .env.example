# Optional — Gemini integration (future/experimental).
# Core RAG features use in-browser Transformers.js and do NOT require this key.
GEMINI_API_KEY=your_gemini_api_key_here

# Docker Compose (optional — used by ./start-services.sh)
COMPOSE_PROJECT_NAME=rag-explorer
HOST_PORT=3000
# GEMINI_API_KEY above is also passed as a build ARG when set in .env (baked into bundle).
